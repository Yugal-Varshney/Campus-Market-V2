# Public (safe for the browser) — Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL, used for email confirmation / password-reset links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "false" to let signed-out visitors browse listings (V1 required login)
REQUIRE_LOGIN_TO_BROWSE=true

# NEVER prefix with NEXT_PUBLIC_. Not used by the app today; reserved for future
# admin/moderation server code. Leave blank unless you need it.
SUPABASE_SERVICE_ROLE_KEY=
